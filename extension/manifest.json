{
  "manifest_version": 3,
  "name": "AI Job Assistant",
  "version": "1.0",
  "permissions": ["activeTab", "scripting","storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://www.linkedin.com/*"
  ],
  "action": {
  "default_popup": "popup.html"
},
"background": {
  "service_worker": "background.js"
},
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}